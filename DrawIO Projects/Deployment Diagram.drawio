        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle KriGo Deployment Diagram\n\nskinparam shadowing false\nskinparam componentStyle uml2\nskinparam defaultFontName Arial\nleft to right direction\n\n&#39;========================\n&#39; Client Devices\n&#39;========================\n\nnode \&quot;Client Devices\&quot; {\n\n    artifact \&quot;Web Browser\&quot; as Browser\n    artifact \&quot;Mobile Application\&quot; as Mobile\n    artifact \&quot;Admin / Agency Dashboard\&quot; as Admin\n}\n\n&#39;========================\n&#39; VPS Server\n&#39;========================\n\nnode \&quot;Production VPS\\nUbuntu Linux\&quot; {\n\n    node \&quot;Docker Engine\&quot; {\n\n        node \&quot;NGINX Reverse Proxy\&quot; as Nginx\n\n        node \&quot;Frontend Containers\&quot; {\n\n            artifact \&quot;Web Application\\n(Next.js)\&quot; as Web\n\n            artifact \&quot;Admin Application\\n(Next.js)\&quot; as AdminApp\n        }\n\n        node \&quot;Backend Container\&quot; {\n\n            artifact \&quot;NestJS API\&quot; as API\n\n        }\n\n        database \&quot;PostgreSQL\&quot; as PG\n        database \&quot;Redis\&quot; as Redis\n        queue \&quot;RabbitMQ\&quot; as Rabbit\n        database \&quot;Neo4j\&quot; as Neo\n        database \&quot;pgvector\&quot; as Vector\n\n    }\n\n    node \&quot;Coolify\&quot; as Coolify\n}\n\n&#39;========================\n&#39; External Services\n&#39;========================\n\ncloud \&quot;External Services\&quot; {\n\n    node \&quot;Algeria Post\\nEdahabia Gateway\&quot; as Payment\n\n    node \&quot;OpenAI API\&quot; as AI\n\n    node \&quot;Google Maps API\&quot; as Maps\n\n    node \&quot;Cloudflare R2\\n(Amazon S3 Compatible)\&quot; as Storage\n\n    node \&quot;Firebase / SMTP\&quot; as Notify\n}\n\n&#39;========================\n&#39; Connections\n&#39;========================\n\nBrowser --&gt; Nginx : HTTPS\nMobile --&gt; Nginx : HTTPS\nAdmin --&gt; Nginx : HTTPS\n\nNginx --&gt; Web\nNginx --&gt; AdminApp\nNginx --&gt; API : REST / WebSocket\n\nAPI --&gt; PG\nAPI --&gt; Redis\nAPI --&gt; Rabbit\nAPI --&gt; Neo\nAPI --&gt; Vector\n\nAPI --&gt; Payment\nAPI --&gt; AI\nAPI --&gt; Maps\nAPI --&gt; Storage\nAPI --&gt; Notify\n\nCoolify --&gt; Web : Deploy\nCoolify --&gt; AdminApp : Deploy\nCoolify --&gt; API : Deploy\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="oC1bNfiDTcUl1WnnDs_w-10">
