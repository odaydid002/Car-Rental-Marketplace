        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle KriGo Integration Diagram\n\nskinparam componentStyle rectangle\nskinparam shadowing false\nleft to right direction\n\npackage \&quot;KriGo Platform\&quot; {\n\ncomponent \&quot;Web Application\&quot; as Web\ncomponent \&quot;Mobile Application\&quot; as Mobile\ncomponent \&quot;Admin Application\&quot; as Admin\ncomponent \&quot;Agency Application\&quot; as Agency\n\ncomponent \&quot;NestJS Backend API\&quot; as API\n\ncomponent \&quot;Authentication\\nService\&quot; as Auth\ncomponent \&quot;Reservation\\nService\&quot; as Reservation\ncomponent \&quot;Payment\\nService\&quot; as PaymentService\ncomponent \&quot;Notification\\nService\&quot; as Notification\ncomponent \&quot;AI Services\&quot; as AIService\ncomponent \&quot;Storage Service\&quot; as StorageService\ncomponent \&quot;Location Service\&quot; as LocationService\n\nWeb --&gt; API : HTTPS REST\nMobile --&gt; API : HTTPS REST\nAdmin --&gt; API : HTTPS REST\nAgency --&gt; API : HTTPS REST\n\nAPI --&gt; Auth\nAPI --&gt; Reservation\nAPI --&gt; PaymentService\nAPI --&gt; Notification\nAPI --&gt; AIService\nAPI --&gt; StorageService\nAPI --&gt; LocationService\n}\n\ncloud \&quot;Third-Party Services\&quot; {\n\ncomponent \&quot;Algeria Post\\nEdahabia\\nPayment Gateway\&quot; as Edahabia\ncomponent \&quot;OpenAI API\&quot; as OpenAI\ncomponent \&quot;Google Maps API\&quot; as Maps\ncomponent \&quot;Cloudflare R2 /\\nAmazon S3\&quot; as Storage\ncomponent \&quot;Firebase Cloud\\nMessaging\&quot; as FCM\ncomponent \&quot;SMTP Email\\nService\&quot; as SMTP\n\n}\n\nPaymentService --&gt; Edahabia : Payment API\n\nAIService --&gt; OpenAI : AI Requests\n\nStorageService --&gt; Storage : Upload / Download\n\nLocationService --&gt; Maps : Geolocation\n\nNotification --&gt; FCM : Push Notifications\n\nNotification --&gt; SMTP : Email Notifications\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Yx1u8HjFNua_pkFB7-G5-1">
